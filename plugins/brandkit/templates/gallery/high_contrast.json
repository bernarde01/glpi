    "colors": {
        "color_primary": "#111111",
        "color_secondary": "#111111",
        "color_accent": "#ca8a04",
        "color_sidebar": "#000000",
        "color_header": "#000000",
        "login_background_color": "#ffffff",
        "dashboard_card_bg": "#ffffff",
        "dashboard_card_text": "#111111"
    },
    "style": {
        "preset": "high_contrast",
