{
    "id": "bold_gradient",
    "name": "Bold gradient",
    "description": "Teal-to-navy washes on header, sidebar, buttons and login. Spacious IBM Plex.",
    "colors": {
        "color_primary": "#0e7490",
        "color_secondary": "#0f172a",
        "color_accent": "#fe9c5c",
        "color_sidebar": "#0f172a",
        "color_header": "#0e7490",
        "login_background_color": "#042f2e"
    },
    "style": {
