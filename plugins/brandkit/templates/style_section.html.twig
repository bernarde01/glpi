{{ fields.largeTitle(__('Gradients and backgrounds', 'brandkit'), 'ti ti-gradienter') }}
{% for key, label in {
    gradient_header: __('Header gradient', 'brandkit'),
    gradient_sidebar: __('Sidebar gradient', 'brandkit'),
