{# Style layer: structured settings, presets, live preview, import/export #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set radius_opts = {
    0: '0',
    2: '2px',
    4: '4px',
    6: '6px',
    8: '8px',
    12: '12px',
    16: '16px',
    20: '20px',
    24: '24px',
    999: __('Pill', 'brandkit')
} %}
{% set shadow_opts = {
    none: __('None', 'brandkit'),
    soft: __('Soft', 'brandkit'),
    medium: __('Medium', 'brandkit'),
    strong: __('Strong', 'brandkit'),
    glow: __('Coloured glow', 'brandkit')
} %}
{% set hover_opts = {
    none: __('None', 'brandkit'),
    lift: __('Lift', 'brandkit'),
    grow: __('Grow', 'brandkit'),
    glow: __('Glow', 'brandkit')
} %}
{% set nav_opts = {
    background: __('Background', 'brandkit'),
    accent_bar: __('Left accent bar', 'brandkit'),
    scale: __('Scale', 'brandkit'),
    indent: __('Indent', 'brandkit')
} %}
{% set ro = {readonly: not can_edit} %}

{{ fields.largeTitle(__('Style', 'brandkit'), 'ti ti-sparkles') }}
<p class="text-muted">
    {{ __('Structured visual restyling (menus, shape, elevation, motion, density, gradients, watermarks). Settings generate CSS variables and a small set of stable GLPI/Tabler selectors. Free-form CSS above is still applied last.', 'brandkit') }}
</p>

<input type="hidden" name="style[preset]" value="{{ style.preset|e('html_attr') }}" />
<input type="hidden" name="apply_preset" id="brandkit-apply-preset" value="" />

<div class="brandkit-gallery-toolbar mb-2 d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted">{{ __('Browse a template, try it on this page, then Apply to copy it into the form. Save the entity to persist.', 'brandkit') }}</span>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="brandkit-try-cancel" hidden>
        {{ __('Cancel try-it', 'brandkit') }}
    </button>
</div>
<div class="brandkit-gallery mb-4" id="brandkit-gallery" data-testid="brandkit-gallery">
    {% for tpl in style_templates %}
        {% set c = tpl.colors %}
        <article class="brandkit-gallery-card{% if tpl.custom %} is-custom{% endif %}"
                 data-template="{{ tpl.id }}"
                 {% if tpl.db_id %}data-db-id="{{ tpl.db_id }}"{% endif %}
                 style="--g-primary: {{ c.color_primary|default('#0e7490') }}; --g-sidebar: {{ c.color_sidebar|default('#0f172a') }}; --g-header: {{ c.color_header|default('#0e7490') }}; --g-accent: {{ c.color_accent|default('#fe9c5c') }}; --g-radius: {{ tpl.style.radius_cards }}px;">
            <button type="button" class="brandkit-gallery-hit brandkit-try" {% if not can_edit %}disabled{% endif %} aria-label="{{ __('Try %s', 'brandkit')|format(tpl.name) }}">
                <div class="brandkit-gallery-thumb" data-sidebar="{{ tpl.style.sidebar_preset }}" data-header="{{ tpl.style.header_style }}">
                    <div class="g-side"></div>
                    <div class="g-main">
                        <div class="g-head"></div>
                        <div class="g-card"></div>
                    </div>
                </div>
                <h3 class="brandkit-gallery-name">{{ tpl.name }}</h3>
                <p class="brandkit-gallery-desc">{{ tpl.description }}</p>
            </button>
            <div class="brandkit-gallery-actions">
                <button type="button" class="btn btn-sm btn-outline-primary brandkit-try" data-template="{{ tpl.id }}" {% if not can_edit %}disabled{% endif %}>{{ __('Try it', 'brandkit') }}</button>
                <button type="button" class="btn btn-sm btn-primary brandkit-apply" data-template="{{ tpl.id }}" {% if not can_edit %}disabled{% endif %}>{{ __('Apply', 'brandkit') }}</button>
                {% if tpl.custom and can_edit %}
                    <button type="button" class="btn btn-sm btn-outline-danger brandkit-delete" data-db-id="{{ tpl.db_id }}">{{ __('Delete', 'brandkit') }}</button>
                {% endif %}
            </div>
        </article>
    {% endfor %}
</div>
<script type="application/json" id="brandkit-gallery-json">{{ style_templates|json_encode|raw }}</script>
<script type="application/json" id="brandkit-ui-config">{{ {
    previewCss: preview_css_url,
    templateUrl: template_url,
    canEdit: can_edit
}|json_encode|raw }}</script>

<div class="mb-4" id="brandkit-save-template">
    {{ fields.textField('template_name', '', __('Save current look as a template', 'brandkit'), ro|merge({
        helper: __('Stores a copy in the gallery (not applied until you click Apply). Logos are not included.')
    })) }}
    {{ fields.textField('template_description', '', __('Template description', 'brandkit'), ro) }}
    <button type="button" class="btn btn-outline-secondary" id="brandkit-save-template-btn" {% if not can_edit %}disabled{% endif %}>
        <i class="ti ti-device-floppy"></i>
        {{ __('Save as template', 'brandkit') }}
    </button>
    <p id="brandkit-template-status" class="text-muted small mt-2" hidden></p>
</div>

<div id="brandkit-live-preview" class="brandkit-preview mb-4" data-testid="brandkit-preview" aria-label="{{ __('Live preview', 'brandkit') }}">
    <div class="brandkit-preview-sidebar">
        <div class="brandkit-preview-nav active">{{ __('Dashboard', 'brandkit') }}</div>
        <div class="brandkit-preview-nav">{{ __('Tickets', 'brandkit') }}</div>
        <div class="brandkit-preview-nav">{{ __('Assets', 'brandkit') }}</div>
    </div>
    <div class="brandkit-preview-main">
        <div class="brandkit-preview-header">{{ __('Header', 'brandkit') }}</div>
        <div class="brandkit-preview-card">
            <div class="brandkit-preview-card-title">{{ __('Sample card', 'brandkit') }}</div>
            <p class="mb-2">{{ __('Buttons, menu and chart update as you change Style values.', 'brandkit') }}</p>
            <button type="button" class="brandkit-preview-btn">{{ __('Primary action', 'brandkit') }}</button>
            <div class="brandkit-preview-chart" aria-hidden="true"></div>
        </div>
        <div id="brandkit-contrast-warn" class="alert alert-warning mt-2 d-none" role="status"></div>
    </div>
</div>

{{ fields.dropdownArrayField('style[sidebar_preset]', style.sidebar_preset, {
    default: __('Default', 'brandkit'),
    compact: __('Compact', 'brandkit'),
